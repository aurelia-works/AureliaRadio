{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurelia Radio",
  "version": "0.1.0",
  "identifier": "com.aurelia.radio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aurelia Radio",
        "width": 1040,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 }
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "macOS": { "minimumSystemVersion": "13.0" },
    "icon": ["icons/icon.png"]
  }
}
